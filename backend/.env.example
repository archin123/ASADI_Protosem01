# Content Recycler Environment Variables
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_sih_hackathon_jwt_key_2026_xyz

# MongoDB Atlas URI (optional - will automatically fallback to in-memory mode if omitted)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/content_recycler?retryWrites=true&w=majority
MONGODB_URI=
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Observability & Tracing Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=Content

# Alternative LangSmith SDK Aliases
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=Content
