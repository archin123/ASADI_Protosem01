# Content Recycler Environment Configuration
# Smart India Hackathon (SIH) Showcase

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Leave empty or omit to automatically engage the In-Memory Demo Storage Engine
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/content_recycler?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_sih_hackathon_jwt_key_2026_xyz

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith / LangChain Observability & Tracing Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=Content

# LangSmith Alternative SDK Aliases
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=Content
